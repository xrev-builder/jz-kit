# Form Inspector settings. This file holds THIS service's settings only.
# Never mount or pass another system's credentials into this container.

# --- credentials (at least one is required, or the process refuses to start) ---
# name:secret pairs, comma separated. Each secret must be at least 16 characters.
# Give each integration its own key so usage shows up per consumer in createdBy.
FI_API_KEYS=cli:REPLACE_WITH_A_LONG_RANDOM_SECRET

# Enables the web UI. At least 8 characters; make it long and random.
FI_UI_PASSCODE=REPLACE_WITH_A_LONG_RANDOM_PASSCODE

# Signs UI session cookies. Set it so sessions survive a restart.
# Rotating this value invalidates every session immediately, which is the incident response
# for a stolen cookie: sessions are stateless and logout only clears the cookie locally.
FI_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- exposure ---
# 1 keeps the Secure flag and the __Host- cookie prefix. Set 0 ONLY for plain http on localhost.
FI_COOKIE_SECURE=1

# The single-IP header your reverse proxy sets.
FI_CLIENT_IP_HEADER=cf-connecting-ip

# WARNING: the header above counts ONLY when the socket peer is inside these networks.
# The default trusts the whole Docker bridge range, which is right for a reverse proxy on the
# host. On a shared Docker network, narrow this to your proxy's exact address, or any other
# container on that bridge can forge the header and get a fresh rate-limit allowance.
FI_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# --- browser ---
# 1 refuses to browse without the Chromium sandbox. NEVER set 0 on a deployment the internet
# can reach. See the README for what the host needs for the sandbox to start.
FI_REQUIRE_SANDBOX=1

# --- limits ---
FI_RETENTION_DAYS=14
FI_UI_MAX_URLS=5
FI_UI_AUDITS_PER_HOUR=6
FI_UI_URLS_PER_HOUR=20
FI_KEY_AUDITS_PER_HOUR=60
FI_KEY_URLS_PER_HOUR=300
FI_GLOBAL_URLS_PER_DAY=500
FI_MAX_QUEUED_AUDITS=10
FI_MAX_ACTIVE_AUDITS=2
FI_MAX_CONCURRENT_INSPECTIONS=2
FI_LOGIN_PER_MINUTE=5

# --- host port published on loopback ---
FI_HOST_PORT=3011
