---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { photo } from '../lib/photos';
import { org, locations } from '../data/site';

interface Props {
  title: string;            // page name; " | HYPE Athletics" is appended
  description: string;
  ogPhoto?: string;
  jsonLd?: object | object[];
  bare?: boolean;           // home page uses the full title as-is
}
const { title, description, ogPhoto = 'dh-courts', jsonLd, bare = false } = Astro.props;
const fullTitle = bare ? title : `${title} | HYPE Athletics`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: photo(ogPhoto), width: 1200, height: 630, format: 'jpg', quality: 78, fit: 'cover' });
const ogUrl = new URL(og.src, Astro.site).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: org.name,
  alternateName: org.expansion,
  url: 'https://hypeathletics.org/',
  logo: 'https://hypeathletics.org/favicon.svg',
  email: org.email,
  telephone: '+1-313-436-0043',
  foundingDate: String(org.founded),
  founder: { '@type': 'Person', name: org.founder },
  description: org.mission,
  areaServed: 'Wayne County, Michigan',
  sameAs: [org.instagram, org.facebook],
  location: Object.values(locations).map((l) => ({
    '@type': 'Place', name: l.fullName,
    address: { '@type': 'PostalAddress', streetAddress: l.street, addressLocality: l.city, addressRegion: l.region, postalCode: l.zip, addressCountry: 'US' },
  })),
};
const ld = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HYPE Athletics" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var t = localStorage.getItem('hype-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        document.documentElement.dataset.themePref = t || 'system';
      } catch (e) {}
    </script>
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
