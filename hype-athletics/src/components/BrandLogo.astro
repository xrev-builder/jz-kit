---
// Small brand badge next to an insurance / fitness-program name.
// Source: each brand's own official site icon, stored in src/assets/insurance/<id>.png (64×64).
// Inlined as a data URI (a few KB each), so no extra requests. Renders nothing if there's no file.
interface Props { id: string; name: string; size?: number; fallback?: boolean }
const { id, name, size = 28, fallback = false } = Astro.props;
const initials = name.replace(/­/g, '').split(/[\s&]+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const files = import.meta.glob<string>('../assets/insurance/*.png', { eager: true, query: '?inline', import: 'default' });
const entry = Object.entries(files).find(([p]) => p.split('/').pop() === `${id}.png`);
const src = entry?.[1];
---
{src ? (
  <span class="badge" style={`--s:${size}px`}>
    <img src={src} alt={`${name.replace(/­/g, '')} logo`} width={size} height={size} />
  </span>
) : fallback ? (
  <span class="badge empty" style={`--s:${size}px`} aria-hidden="true">{initials}</span>
) : null}
<style>
  .badge {
    width: var(--s); height: var(--s); flex-shrink: 0; display: inline-grid; place-items: center;
    border-radius: 7px; background: #fff; overflow: hidden; box-shadow: 0 0 0 1px rgb(0 0 0 / .08);
  }
  .badge img { width: 100%; height: 100%; object-fit: contain; }
  .empty { background: var(--surface-3); color: var(--fg-3); font-size: 10px; font-weight: 600; letter-spacing: .04em; box-shadow: none; }
</style>
