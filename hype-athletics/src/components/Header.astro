---
import { nav } from '../data/nav';
import { portals } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (item: (typeof nav)[number]) =>
  path === item.href || (item.groups ?? []).some((g) => g.links.some((l) => l.href === path));
const logins = [
  { label: 'Gym membership', desc: 'Billing, check-ins, account', href: portals.membershipLogin, track: 'iclub' },
  { label: 'Programs · Dearborn Heights', desc: 'Leagues, camps, registrations', href: portals.programsLoginDH, track: 'leagueapps_dh' },
  { label: 'Programs · Wayne', desc: 'Leagues, camps, registrations', href: portals.programsLoginWayne, track: 'leagueapps_wayne' },
];
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="HYPE Athletics home"><Logo /></a>

    <nav class="primary" aria-label="Main">
      <ul>
        {nav.map((item, i) => (
          <li>
            {item.groups ? (
              <>
                <button class:list={['nav-link', { active: isActive(item) }]} aria-expanded="false" aria-controls={`menu-${i}`} data-menu-btn>
                  {item.label}<Icon name="ChevronDown" size={14} />
                </button>
                <div class="menu" id={`menu-${i}`} data-menu hidden>
                  <div class="menu-inner" style={`--cols:${item.groups.length}`}>
                    {item.groups.map((g) => (
                      <div>
                        <p class="eyebrow plain">{g.title}</p>
                        <ul>
                          {g.links.map((l) => (
                            <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}><span>{l.label}</span>{l.desc && <span class="desc">{l.desc}</span>}</a></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <a href={item.href} class:list={['nav-link', { active: isActive(item) }]} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <div class="login">
        <button class="nav-link login-btn" aria-expanded="false" aria-controls="menu-login" data-menu-btn>
          <Icon name="CircleUserRound" size={18} /><span class="login-label">Log in</span>
        </button>
        <div class="menu menu-right" id="menu-login" data-menu hidden>
          <div class="menu-inner" style="--cols:1">
            <div>
              <p class="eyebrow plain">Member portals</p>
              <ul>{logins.map((l) => <li><a href={l.href} rel="noopener" target="_blank" data-track="portal_click" data-portal={l.track}><span>{l.label}</span><span class="desc">{l.desc}</span></a></li>)}</ul>
            </div>
          </div>
        </div>
      </div>
      <a href="/membership/#plans" class="btn btn-primary btn-sm join" data-track="join_click" data-placement="header">Join now</a>
      <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-mobile-btn>
        <span class="sr-only">Menu</span>
        <span class="i-open"><Icon name="Menu" size={22} /></span>
        <span class="i-close"><Icon name="X" size={22} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile hidden>
    <div class="wrap">
      <ul class="m-list">
        {nav.map((item) => (
          <li>
            {item.groups ? (
              <details>
                <summary>{item.label}<Icon name="ChevronDown" size={20} /></summary>
                {item.groups.map((g) => (
                  <div class="m-group">
                    <p class="eyebrow plain">{g.title}</p>
                    <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
                  </div>
                ))}
              </details>
            ) : (
              <a href={item.href} class="m-top">{item.label}</a>
            )}
          </li>
        ))}
      </ul>
      <div class="m-portals">
        <p class="eyebrow plain">Member portals</p>
        {logins.map((l) => <a href={l.href} rel="noopener" target="_blank" data-track="portal_click" data-portal={l.track}>{l.label}<Icon name="ArrowUpRight" size={16} /></a>)}
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]')!;
  const btns = [...header.querySelectorAll<HTMLButtonElement>('[data-menu-btn]')];
  const menuOf = (b: HTMLElement) => document.getElementById(b.getAttribute('aria-controls')!) as HTMLElement;
  const closeAll = (except?: HTMLElement) => btns.forEach((b) => { if (b !== except) { b.setAttribute('aria-expanded', 'false'); menuOf(b).hidden = true; } });
  btns.forEach((b) => {
    const li = b.parentElement!;
    const open = () => { closeAll(b); b.setAttribute('aria-expanded', 'true'); menuOf(b).hidden = false; };
    const close = () => { b.setAttribute('aria-expanded', 'false'); menuOf(b).hidden = true; };
    b.addEventListener('click', () => (b.getAttribute('aria-expanded') === 'true' ? close() : open()));
    let t: number | undefined;
    li.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { clearTimeout(t); open(); } });
    li.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse') t = window.setTimeout(close, 160); });
    li.addEventListener('focusout', (e) => { if (!li.contains((e as FocusEvent).relatedTarget as Node)) close(); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openBtn = btns.find((b) => b.getAttribute('aria-expanded') === 'true');
    closeAll(); openBtn?.focus();
  });
  document.addEventListener('click', (e) => { if (!header.contains(e.target as Node)) closeAll(); });

  const mBtn = header.querySelector<HTMLButtonElement>('[data-mobile-btn]')!;
  const mNav = header.querySelector<HTMLElement>('[data-mobile]')!;
  mBtn.addEventListener('click', () => {
    const open = mBtn.getAttribute('aria-expanded') !== 'true';
    mBtn.setAttribute('aria-expanded', String(open));
    mNav.hidden = !open;
    document.documentElement.classList.toggle('nav-open', open);
  });

  // Shadow appears once the page scrolls
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; view-transition-name: site-header; }
  /* Blur lives on a pseudo-element: backdrop-filter on the header would trap the fixed mobile menu. */
  .site-header::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.5) blur(14px); -webkit-backdrop-filter: saturate(1.5) blur(14px);
    border-bottom: 1px solid transparent; transition: border-color var(--d-std) var(--ease);
  }
  .site-header.scrolled::before { border-bottom-color: var(--line); }
  :global(html.nav-open) .site-header::before { background: var(--bg); }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 28px; }
  .brand { width: 156px; flex-shrink: 0; display: block; padding: 8px 0; }
  .primary { display: none; flex: 1; min-width: 0; }
  .primary > ul { list-style: none; display: flex; align-items: center; gap: 4px; }
  .primary li, .login { position: relative; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 4px; height: 40px; padding: 0 12px; border-radius: var(--r-8);
    font-size: var(--t-14); font-weight: 500; color: var(--fg-2); text-decoration: none; background: none; border: 0; cursor: pointer;
    transition: color var(--d-micro) var(--ease), background-color var(--d-micro) var(--ease);
  }
  .nav-link:hover, .nav-link[aria-expanded='true'] { color: var(--fg); background: var(--surface-2); }
  .nav-link.active { color: var(--fg); }
  .nav-link.active::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: -14px; height: 3px; background: var(--accent); transform: skewX(-20deg); }
  .nav-link :global(.icon) { color: var(--fg-3); transition: transform var(--d-std) var(--ease-out); }
  .nav-link[aria-expanded='true'] > :global(.icon:last-child) { transform: rotate(180deg); }
  .login-btn[aria-expanded='true'] :global(.icon) { transform: none !important; }

  .menu { position: absolute; top: calc(100% + 14px); left: -16px; z-index: 60; }
  .menu-right { left: auto; right: -8px; }
  .menu::before { content: ''; position: absolute; inset: -14px 0 auto 0; height: 14px; }
  .menu-inner {
    display: grid; grid-template-columns: repeat(var(--cols), 220px); gap: 28px; padding: 24px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-12); box-shadow: var(--shadow-2);
    animation: menu-in var(--d-std) var(--ease-out);
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }
  .menu .eyebrow { margin-bottom: 10px; }
  .menu ul { list-style: none; display: grid; gap: 2px; }
  .menu a { display: grid; padding: 7px 10px; margin-inline: -10px; border-radius: var(--r-6); font-size: var(--t-14); color: var(--fg); text-decoration: none; }
  .menu a:hover, .menu a[aria-current='page'] { background: var(--surface-2); }
  .menu .desc { font-size: var(--t-12); color: var(--fg-3); }

  .actions { margin-left: auto; display: flex; align-items: center; gap: 6px; }
  .login-label { display: none; }
  @media (min-width: 560px) { .login-label { display: inline; } }
  .join { margin-left: 6px; }
  .icon-btn { width: 44px; height: 44px; display: inline-grid; place-items: center; border: 0; background: transparent; border-radius: var(--r-8); cursor: pointer; color: var(--fg); }
  .icon-btn:hover { background: var(--surface-2); }
  .i-close { display: none; }
  .menu-toggle[aria-expanded='true'] .i-open { display: none; }
  .menu-toggle[aria-expanded='true'] .i-close { display: inline; }

  .mobile-nav { position: fixed; inset: var(--header-h) 0 0 0; overflow-y: auto; overscroll-behavior: contain; background: var(--bg); padding-block: 8px 120px; }
  :global(html.nav-open) { overflow: hidden; }
  .m-list { list-style: none; }
  .m-list > li { border-bottom: 1px solid var(--line); }
  .m-top, .m-list summary {
    display: flex; align-items: center; justify-content: space-between; min-height: 64px;
    font-family: var(--font-display); font-style: italic; font-weight: 600; text-transform: uppercase; font-size: var(--t-32);
    text-decoration: none; cursor: pointer; list-style: none; color: var(--fg);
  }
  .m-list summary::-webkit-details-marker { display: none; }
  .m-list details[open] summary :global(.icon) { transform: rotate(180deg); }
  .m-group { padding-bottom: 16px; }
  .m-group ul { list-style: none; margin-top: 4px; }
  .m-group a { display: block; padding: 10px 0; text-decoration: none; color: var(--fg-2); font-size: var(--t-16); }
  .m-portals { display: grid; gap: 4px; margin-top: 28px; }
  .m-portals a { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; text-decoration: none; color: var(--fg-2); border-bottom: 1px solid var(--line); }

  @media (min-width: 1120px) { .primary { display: block; } .menu-toggle, .mobile-nav { display: none !important; } }
  @media (min-width: 1120px) and (max-width: 1260px) { .brand { width: 132px; } .bar { gap: 16px; } .nav-link { padding: 0 10px; } }
</style>
