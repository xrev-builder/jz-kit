---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { org, locations, hours } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Programs', links: [['All programs', '/programs/'], ['Basketball', '/basketball/'], ['Soccer', '/soccer/'], ['Summer Discovery', '/summer-discovery/'], ['Adult Leagues', '/adult-leagues/'], ['Personal Training', '/personal-group-fitness/']] },
  { title: 'Visit', links: [['Membership', '/membership/'], ['Rentals', '/rentals/'], ['Events', '/events/'], ['Facility updates', '/facility-updates/'], ['Policies', '/policies-2/'], ['FAQ', '/faq/']] },
  { title: 'Organization', links: [['Our story', '/about-us/'], ['Leadership', '/meet-the-team/'], ['Community services', '/social-services/'], ['Careers', '/careers/'], ['Volunteer', '/volunteer/'], ['Report an incident', '/incident-report/']] },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="intro">
        <a href="/" class="f-logo" aria-label="HYPE Athletics home"><Logo /></a>
        <p class="exp display">Helping Youth Progress &amp; Excel</p>
        <p class="small muted mission">A nonprofit serving Wayne County youth and families since {org.founded} through sports, education, mentoring and prevention.</p>
        <div class="btn-row">
          <a href="/donate/" class="btn btn-primary btn-sm"><Icon name="Heart" size={14} />Donate</a>
          <a href="/volunteer/" class="btn btn-secondary btn-sm">Volunteer</a>
        </div>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <p class="eyebrow">{c.title}</p>
          <ul>{c.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
        </nav>
      ))}
    </div>

    <div class="locs">
      {Object.values(locations).map((l) => (
        <div>
          <p class="h4">{l.name}</p>
          <address class="small">
            <a href={l.mapsUrl} rel="noopener" target="_blank">{l.street}<br />{l.city}, {l.region} {l.zip}</a><br />
            <a href={`tel:${l.phoneHref}`} class="mono">{l.phone}</a>
          </address>
        </div>
      ))}
      <div>
        <p class="h4">Hours</p>
        <dl class="small hours">
          {hours.map((h) => <div><dt>{h.days}</dt><dd class="mono">{h.time}</dd></div>)}
        </dl>
        <p class="small muted">Dearborn Heights &amp; Wayne. Holiday hours on <a href="/facility-updates/">Facility Updates</a>.</p>
      </div>
    </div>

    <div class="bottom small">
      <p>© {org.founded}–{year} HYPE Athletics. A nonprofit organization.</p>
      <div class="social">
        <a href={`mailto:${org.email}`} class="icon-link"><Icon name="Mail" size={18} label="Email HYPE Athletics" /></a>
        <a href={org.instagram} class="icon-link" rel="noopener" target="_blank"><Icon name="Instagram" size={18} label="HYPE Athletics on Instagram" /></a>
        <a href={org.facebook} class="icon-link" rel="noopener" target="_blank"><Icon name="Facebook" size={18} label="HYPE Athletics on Facebook" /></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-2); border-top: 1px solid var(--line); padding-block: 56px 32px; padding-bottom: max(32px, env(safe-area-inset-bottom, 0px)); margin-top: 0; }
  .top { display: grid; gap: 32px; }
  @media (min-width: 720px) { .top { grid-template-columns: repeat(3, minmax(0, 1fr)); } .intro { grid-column: 1 / -1; } }
  @media (min-width: 1024px) { .top { grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); } .intro { grid-column: auto; } }
  .f-logo { display: block; width: 168px; }
  .exp { font-size: var(--t-25); margin-top: 16px; }
  .mission { margin-top: 8px; max-width: 40ch; }
  .intro .btn-row { margin-top: 20px; }
  nav .eyebrow { margin-bottom: 12px; }
  nav ul { list-style: none; display: grid; gap: 8px; }
  nav a { text-decoration: none; color: var(--fg-2); font-size: var(--t-14); }
  nav a:hover { color: var(--fg); text-decoration: underline; }
  .locs { display: grid; gap: 24px; margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--line); }
  @media (min-width: 640px) { .locs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .locs { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .locs .h4 { font-size: var(--t-14); margin-bottom: 6px; }
  address { font-style: normal; color: var(--fg-2); line-height: 1.7; }
  address a { text-decoration: none; color: inherit; }
  address a:hover { text-decoration: underline; }
  .hours { margin: 0 0 6px; display: grid; gap: 2px; color: var(--fg-2); }
  .hours div { display: flex; justify-content: space-between; gap: 12px; }
  .hours dd { margin: 0; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--fg-3); }
  .social { display: flex; gap: 4px; }
  .icon-link { width: 40px; height: 40px; display: inline-grid; place-items: center; border-radius: var(--r-8); color: var(--fg-2); }
  .icon-link:hover { background: var(--surface-3); color: var(--fg); }
</style>
