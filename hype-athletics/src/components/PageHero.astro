---
import Photo from './Photo.astro';
interface Props { eyebrow?: string; title: string; lede?: string; photo?: string; photoAlt?: string; position?: string }
const { eyebrow, title, lede, photo, photoAlt = '', position } = Astro.props;
---
<section class:list={['phero', { 'has-photo': photo }]}>
  <div class="wrap inner">
    <div class="copy">
      {eyebrow && <p class="eyebrow red">{eyebrow}</p>}
      <h1 class="display h1">{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <div class="slot"><slot /></div>
    </div>
    {photo && (
      <div class="media">
        <Photo src={photo} alt={photoAlt} eager sizes="(min-width: 960px) 560px, 100vw" widths={[480, 720, 1120]} position={position} />
      </div>
    )}
  </div>
</section>
<style>
  .phero { padding-block: 40px 48px; border-bottom: 1px solid var(--line); }
  .inner { display: grid; gap: 32px; align-items: center; }
  .copy > * + * { margin-top: 16px; }
  .copy .h1 { margin-top: 12px; font-size: clamp(var(--t-40), 6vw, var(--t-64)); }
  .slot:empty { display: none; }
  .slot { margin-top: 24px; }
  .media { border-radius: var(--r-18); overflow: hidden; aspect-ratio: 16 / 10; }
  @media (min-width: 960px) {
    .phero { padding-block: 64px; }
    .has-photo .inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
    .media { aspect-ratio: 5 / 4; }
  }
</style>
