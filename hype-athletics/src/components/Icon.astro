---
import * as icons from 'lucide-static';
interface Props { name: keyof typeof icons; size?: number; class?: string; label?: string }
const { name, size = 16, class: cls = '', label } = Astro.props;
const raw = (icons as Record<string, string>)[name as string] ?? '';
const svg = raw
  .replace(/\n\s*/g, ' ')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, 'stroke-width="1.75"')
  .replace(/class="([^"]*)"/, `class="$1 icon ${cls}"`)
  .replace('<svg', label ? `<svg role="img" aria-label="${label}"` : '<svg aria-hidden="true" focusable="false"');
---
<Fragment set:html={svg} />
