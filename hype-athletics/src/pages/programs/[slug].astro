---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import { locations, sportById } from '../../data/site';
import { currentPrograms, status, type Program } from '../../data/programs';

export function getStaticPaths() {
  return currentPrograms.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Program };
const sport = sportById[p.sport];
const loc = locations[p.location];
const st = status(p);
const related = currentPrograms.filter((x) => x.slug !== p.slug && (x.sport === p.sport || x.location === p.location)).sort((a, b) => Number(b.sport === p.sport) - Number(a.sport === p.sport)).slice(0, 3);
const tbd = 'To be announced';
const facts = [
  ['Who', p.ages ?? tbd],
  ['Days', p.days ?? (p.ongoing ? 'Ask the front desk' : tbd)],
  ['Time', p.time ?? tbd],
  ['Dates', p.dates ?? (p.ongoing ? 'Ongoing · join anytime' : tbd)],
  ['Where', `HYPE ${loc.name}, ${loc.street}`],
  ['Fee', p.fee ? `${p.fee}${p.feeNote ? ` · ${p.feeNote}` : ''}` : tbd],
];
const name = `${p.title}${p.ages ? ` (${p.ages})` : ''}`;
const desc = `${p.title} at HYPE Athletics ${loc.name}. ${[p.ages, p.days, p.time, p.dates, p.fee && `${p.fee}${p.feeNote ? ' ' + p.feeNote : ''}`].filter(Boolean).join(' · ')}. ${p.blurb}`.slice(0, 160);
const place = { '@type': 'Place', name: loc.fullName, address: { '@type': 'PostalAddress', streetAddress: loc.street, addressLocality: loc.city, addressRegion: loc.region, postalCode: loc.zip, addressCountry: 'US' } };
const offer = p.fee && /\d/.test(p.fee) ? { '@type': 'Offer', price: p.fee.replace(/[^\d.]/g, ''), priceCurrency: 'USD', url: p.url, availability: 'https://schema.org/InStock' } : undefined;
const ld = p.start ? {
  '@context': 'https://schema.org', '@type': 'SportsEvent', name, description: p.blurb, sport: sport.name,
  startDate: p.start, endDate: p.end ?? p.start, eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', location: place,
  organizer: { '@id': 'https://hypeathletics.org/#org' }, ...(offer ? { offers: offer } : {}),
  image: `https://hypeathletics.org/favicon.svg`,
} : {
  '@context': 'https://schema.org', '@type': 'Service', name, description: p.blurb, serviceType: sport.name,
  provider: { '@id': 'https://hypeathletics.org/#org' }, areaServed: place, ...(offer ? { offers: offer } : {}),
};
---
<Base title={`${p.title} · ${loc.name}`} description={desc} ogPhoto={sport.photo} jsonLd={ld}
  crumbs={[{ name: 'Programs', href: '/programs/' }, { name: sport.name, href: `/${sport.id}/` }, { name: p.title, href: `/programs/${p.slug}/` }]}>
  <section class="hero">
    <div class="wrap grid2">
      <div class="copy">
        <nav class="crumbs small" aria-label="Breadcrumb"><a href="/programs/">Programs</a><span>/</span><a href={`/${sport.id}/`}>{sport.name}</a></nav>
        <p class:list={['st', st.tone]}>{st.label}{p.spots && 50 >= p.spots ? ` · ${p.spots} spots left` : ''}</p>
        <h1 class="display h1">{p.title}</h1>
        <p class="lede">{p.blurb}</p>
        <div class="btn-row cta">
          {p.url ? (
            <a href={p.url} class="btn btn-primary btn-lg" rel="noopener" target="_blank" data-track="program_register_click" data-program={p.slug} data-sport={p.sport} data-location={p.location} data-placement="detail">
              {p.frontDesk ? 'View & register' : 'Register now'}<Icon name="ArrowUpRight" size={18} />
            </a>
          ) : null}
          <a href={`tel:${loc.phoneHref}`} class="btn btn-secondary btn-lg"><Icon name="Phone" size={16} />Ask a question</a>
        </div>
        {p.frontDesk && <p class="small muted">You can also register in person at the HYPE {loc.name} front desk.</p>}
      </div>
      <div class="media"><Photo src={sport.photo} alt="" eager sizes="(min-width: 960px) 520px, 100vw" widths={[480, 800, 1040]} /></div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <dl class="board">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd class={v === tbd ? 'tbd' : undefined}>{v}</dd></div>)}
      </dl>
      {p.todo?.length ? <p class="small muted note">Some details are still being finalized. Call <a href={`tel:${loc.phoneHref}`}>{loc.phone}</a> for the latest.</p> : null}
    </div>
  </section>

  <section class="section tight">
    <div class="wrap two">
      <div class="stack-16">
        <h2 class="display h3">Good to know</h2>
        <ul class="checks small">
          <li><Icon name="Check" size={14} />Registration and payment happen on our secure LeagueApps page.</li>
          <li><Icon name="Check" size={14} />Full refund if HYPE cancels a session. Other refund rules vary by program.</li>
          <li><Icon name="Check" size={14} />Membership isn’t required, but members get child care and the Homework Club free.</li>
        </ul>
        <a href="/policies-2/" class="link-arrow">Program policies<Icon name="ArrowRight" size={14} /></a>
      </div>
      <div class="card card-pad stack-8 member">
        <p class="eyebrow">Make it a family thing</p>
        <p class="h4">Parents train while kids play.</p>
        <p class="small muted">Family memberships include the gym, group classes and free child care.</p>
        <a href="/membership/#plans" class="link-arrow" data-track="join_click" data-placement="program_detail">See membership plans<Icon name="ArrowRight" size={14} /></a>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section tint">
      <div class="wrap">
        <div class="sec-head"><div><p class="eyebrow">You might also like</p></div><a href={`/programs/?sport=${p.sport}`} class="link-arrow">All {sport.name.toLowerCase()} programs<Icon name="ArrowRight" size={14} /></a></div>
        <div class="grid grid-3">{related.map((r) => <ProgramCard p={r} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .hero { padding-block: 40px 24px; }
  @media (min-width: 960px) { .hero { padding-block: 72px 32px; } }
  .grid2 { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 960px) { .grid2 { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 64px; } }
  .copy > * + * { margin-top: 18px; }
  .crumbs { display: flex; gap: 8px; color: var(--fg-3); }
  .crumbs a { color: var(--fg-3); text-decoration: none; }
  .crumbs a:hover { color: var(--fg); }
  .st { font-family: var(--font-mono); font-size: var(--t-12); letter-spacing: .08em; text-transform: uppercase; display: inline-flex; gap: 8px; align-items: center; color: var(--fg-2); }
  .st::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--fg-3); }
  .st.open::before, .st.soon::before { background: var(--ok); }
  .st.live::before { background: var(--accent); }
  .h1 { font-size: clamp(var(--t-52), 7vw, var(--t-80)); }
  .cta { margin-top: 28px; }
  .media { aspect-ratio: 4 / 3; border-radius: var(--r-18); overflow: hidden; }
  .board { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-12); overflow: hidden; }
  @media (min-width: 900px) { .board { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .board div { background: var(--surface); padding: 20px 22px; display: grid; gap: 6px; align-content: start; }
  .board dt { font-family: var(--font-mono); font-size: var(--t-11); letter-spacing: .08em; text-transform: uppercase; color: var(--fg-3); }
  .board dd { margin: 0; font-size: var(--t-16); font-weight: 500; }
  .board dd.tbd { color: var(--fg-3); font-weight: 400; font-style: italic; }
  .note { margin-top: 14px; }
  .two { display: grid; gap: 24px; }
  @media (min-width: 900px) { .two { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 56px; align-items: start; } }
  .member { border-left: 3px solid var(--accent); }
</style>
