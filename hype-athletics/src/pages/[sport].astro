---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProgramCard from '../components/ProgramCard.astro';
import Icon from '../components/Icon.astro';
import { sports, locations, gymnastics, type Sport, type LocationId } from '../data/site';
import { currentPrograms } from '../data/programs';

export function getStaticPaths() {
  return sports.map((s) => ({ params: { sport: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: Sport };
const list = currentPrograms.filter((p) => p.sport === s.id).sort((a, b) => (a.start ?? '0').localeCompare(b.start ?? '0'));
const locs = (['dearborn-heights', 'wayne'] as LocationId[]).map((id) => ({ id, items: list.filter((p) => p.location === id) })).filter((l) => l.items.length);
const where = [...new Set(list.map((p) => locations[p.location].name))].join(' & ');
const others = sports.filter((x) => x.id !== s.id && x.group !== 'training').slice(0, 8);
---
<Base title={`${s.name}${where ? ` in ${where}` : ''}`} description={`${s.name} programs at HYPE Athletics${where ? ` in ${where}, MI` : ''}. ${s.intro}`.slice(0, 160)} ogPhoto={s.photo}
  crumbs={[{ name: 'Programs', href: '/programs/' }, { name: s.name, href: `/${s.id}/` }]}>
  <section class="hero">
    <Photo src={s.photo} alt="" eager sizes="100vw" widths={[640, 1200, 1800]} class="bg" />
    <div class="wrap content">
      <p class="eyebrow red">{s.group === 'adults' ? 'Adults' : s.group === 'training' ? 'Training' : 'Youth sports'}</p>
      <h1 class="display h1">{s.name}</h1>
      <p class="lede">{s.intro}</p>
      {list.length > 0 && <a href="#programs" class="btn btn-primary btn-lg">{list.length} program{list.length === 1 ? '' : 's'} open<Icon name="ArrowDown" size={18} /></a>}
    </div>
  </section>

  <section class="section" id="programs">
    <div class="wrap stack-32">
      {locs.length ? locs.map(({ id, items }) => (
        <div>
          <div class="loc-head"><h2 class="display h3">{locations[id].name}</h2><a href={`/${id}/`} class="small muted">{locations[id].street}</a></div>
          <div class="grid grid-3">{items.map((p) => <ProgramCard p={p} showSport={false} showLoc={false} />)}</div>
        </div>
      )) : (
        <div class="zero">
          <p class="display h3">Next season is coming</p>
          <p class="muted">No {s.name.toLowerCase()} sessions are open right now. Follow <a href="https://www.instagram.com/hypeathletics/" rel="noopener" target="_blank">@hypeathletics</a> or call <a href="tel:+13134360043">(313) 436-0043</a> to hear first.</p>
        </div>
      )}
    </div>
  </section>

  {s.extra === 'gymnastics' && (
    <section class="section tint">
      <div class="wrap grid grid-2">
        <div>
          <p class="eyebrow">Fridays at HYPE Wayne</p>
          <h2 class="display h3" style="margin:14px 0 24px">Class schedule</h2>
          <div class="table-wrap"><table><thead><tr><th>Time</th><th>Class</th><th>Ages</th></tr></thead>
            <tbody>{gymnastics.schedule.map((r) => <tr><td class="mono">{r.time}</td><td>{r.name}</td><td>{r.ages || '—'}</td></tr>)}</tbody></table></div>
        </div>
        <div>
          <p class="eyebrow">Monthly</p>
          <h2 class="display h3" style="margin:14px 0 24px">Pricing</h2>
          <div class="table-wrap"><table><thead><tr><th>Class</th><th class="num">Price</th></tr></thead>
            <tbody>{gymnastics.pricing.map((r) => <tr><td>{r.name}</td><td class="num">{r.price}<span class="muted">/{r.per}</span></td></tr>)}</tbody></table></div>
          <p class="small muted" style="margin-top:12px">{gymnastics.fee}</p>
        </div>
      </div>
    </section>
  )}

  <section class="section tight">
    <div class="wrap">
      <p class="eyebrow">More at HYPE</p>
      <ul class="others">{others.map((o) => <li><a href={`/${o.id}/`}>{o.name}</a></li>)}<li><a href="/programs/">All programs →</a></li></ul>
    </div>
  </section>
</Base>
<style>
  .hero { position: relative; min-height: min(72vh, 640px); display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  .hero :global(.bg) { position: absolute; inset: 0; z-index: -2; animation: drift 24s var(--ease) both; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(0 0 0 / .35) 0%, rgb(0 0 0 / .55) 45%, rgb(0 0 0 / .92) 100%); }
  @keyframes drift { from { transform: scale(1.08); } to { transform: scale(1); } }
  .content { padding-block: 120px 56px; color: #fff; }
  .content > * + * { margin-top: 18px; }
  .content .lede { color: rgb(255 255 255 / .82); }
  .content .eyebrow.red { color: #fff; }
  .loc-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-bottom: 20px; }
  .loc-head a { text-decoration: none; }
  .zero { display: grid; gap: 12px; max-width: 560px; }
  .others { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 16px; }
  .others a { font-family: var(--font-display); font-style: italic; font-weight: 600; text-transform: uppercase; font-size: var(--t-25); text-decoration: none; color: var(--fg-2); }
  .others a:hover { color: var(--accent-text); }
</style>
