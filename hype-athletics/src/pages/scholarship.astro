---
import Page from '../components/Page.astro';
import Icon from '../components/Icon.astro';
---
<Page title="Scholarship" seoTitle="HYPE Athletics Scholarship" description="The HYPE Athletics annual scholarship for local students. The current application period has closed; check back for the next announcement."
  eyebrow="Community · Education" lede="Each year HYPE awards scholarships to help local students continue their education.">
  <section class="section">
    <div class="wrap">
      <div class="card card-pad status">
        <span class="chip">Closed</span>
        <div class="stack-8">
          <h2 class="h4">The current scholarship deadline has passed</h2>
          <p class="small muted">We announce the next application window on this page and on Instagram. Want a reminder? Follow <a href="https://www.instagram.com/hypeathletics/" rel="noopener" target="_blank">@hypeathletics</a>.</p>
        </div>
      </div>
      <p class="small muted" style="margin-top:16px">Want to fund a scholarship? <a href="/donate/">Donate</a> or email <a href="mailto:afaraj@hypeathletics.org">afaraj@hypeathletics.org</a>.</p>
    </div>
  </section>
</Page>
<style>.status { display: flex; gap: 16px; align-items: flex-start; max-width: 720px; }</style>
