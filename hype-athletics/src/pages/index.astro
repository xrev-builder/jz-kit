---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ProgramCard from '../components/ProgramCard.astro';
import PlanPicker from '../components/PlanPicker.astro';
import FacilityTour from '../components/FacilityTour.astro';
import { org, membership, locations } from '../data/site';
import { currentPrograms, ageBuckets } from '../data/programs';

const from = Math.min(...membership.locations.map((l) => l.tiers.find((t) => t.name === 'Individual')!.eft));
const today = new Date().toISOString().slice(0, 10);
// Next programs to start (dated, not yet started), then anything in progress
const upcoming = currentPrograms.filter((p) => p.start && p.start > today && p.url).sort((a, b) => a.start!.localeCompare(b.start!));
const varied = upcoming.filter((p, i, a) => a.findIndex((x) => x.sport === p.sport && x.location === p.location) === i);
const featured = [...varied, ...upcoming.filter((p) => !varied.includes(p))].slice(0, 6);
// Hero background: the Dearborn Heights courts. Add more entries here to bring back the crossfade.
const heroSlides = [
  { src: 'dh-courts-wide', label: '5 courts · Dearborn Heights', pos: 'center 60%' },
];
const sportsList = ['Basketball', 'Soccer', 'Volleyball', 'Tae Kwon Do', 'Boxing', 'Wrestling', 'Futsal', 'Pickleball', 'Gymnastics', 'Karate', 'Zumba', 'Strength', 'Speed & agility'];
const ld = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'HYPE Athletics', url: 'https://hypeathletics.org/',
  publisher: { '@id': 'https://hypeathletics.org/#org' },
};
---
<Base bare
  title="HYPE Athletics | Gym, Courts & Youth Sports in Dearborn Heights & Wayne, MI"
  description={`Gym memberships with free child care and group classes, plus youth leagues, camps and court rentals at HYPE Athletics in Dearborn Heights and Wayne, MI. Your first visit is free.`}
  jsonLd={ld}>

  <!-- 1 · Hero: one promise, one action -->
  <section class="hero">
    <div class="slides" aria-hidden="true">
      {heroSlides.map((h, i) => (
        <div class="slide" style={`--i:${i}`}>
          <Photo src={h.src} alt="" eager={i === 0} sizes="100vw" widths={h.src === 'dh-courts-wide' ? [750, 1200, 1800, 2400] : [640, 960, 1400]} position={h.pos} />
          <span class="slide-tag mono">{h.label}</span>
        </div>
      ))}
    </div>
    <div class="wrap hero-in">
      <p class="eyebrow">Dearborn Heights · Wayne · Since {org.founded}</p>
      <h1 class="display hero-h"><span class="ln">Bring the</span> <span class="ln accent">HYPE.</span></h1>
      <p class="lede">Gym, courts, turf and classes.<br />All in one membership.</p>
      <div class="btn-row">
        <a href="/day-pass/" class="btn btn-primary btn-lg" data-track="daypass_click" data-placement="hero">Get a free day pass<Icon name="ArrowRight" size={18} /></a>
        <a href="#plans" class="btn btn-secondary btn-lg" data-track="join_click" data-placement="hero">See plans</a>
      </div>
      <ul class="proof">
        <li><Icon name="Check" size={14} />First visit free</li>
        <li><Icon name="Check" size={14} />Free child care</li>
        <li class="hide-xs"><Icon name="Check" size={14} />Nonprofit since {org.founded}</li>
      </ul>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => <ul>{sportsList.map((s) => <li>{s}</li>)}</ul>)}
    </div>
  </div>

  <!-- 2 · Show the space (facility tour) -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow">Take a look inside</p>
          <h2 class="display h2">Everything under<br />one roof</h2>
        </div>
        <a href="/facilities/" class="link-arrow">Full facility tour<Icon name="ArrowRight" size={16} /></a>
      </div>
      <div class="reveal"><FacilityTour only={['dearborn-heights', 'wayne']} id="home-tour" /></div>
    </div>
  </section>

  <!-- 3 · Sell the membership -->
  <section class="section tint" id="plans">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow red">Membership</p>
          <h2 class="display h2">Pick your plan</h2>
          <p class="lede">Choose a center and a plan. Not sure yet? Your first visit is free.</p>
        </div>
      </div>
      <PlanPicker />
      <a href="/insurance/" class="ins-band" data-track="insurance_click" data-placement="home_plans">
        <span class="ins-copy">
          <span class="eyebrow">Insurance &amp; employer benefits</span>
          <span class="display ins-title">Your insurance may cover your membership</span>
          <span class="ins-names">{membership.insurance.join(' · ')}</span>
        </span>
        <span class="btn btn-primary ins-cta">Check my coverage<Icon name="ArrowRight" size={16} /></span>
      </a>
    </div>
  </section>

  <!-- 4 · Programs (P1) -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          <p class="eyebrow">Leagues · camps · clinics</p>
          <h2 class="display h2">Registering now</h2>
        </div>
        <a href="/programs/" class="btn btn-secondary">All {currentPrograms.length} programs<Icon name="ArrowRight" size={16} /></a>
      </div>
      <div class="ages reveal" aria-label="Find programs by age">
        <span class="small muted">Find by age</span>
        {ageBuckets.map((b) => <a href={`/programs/?age=${b.id}`} data-track="age_shortcut" data-placement={b.id}>{b.label}</a>)}
      </div>
      <div class="grid grid-3 reveal-stagger">{featured.map((p) => <ProgramCard p={p} />)}</div>
    </div>
  </section>

  <!-- 5 · Teams -->
  <section class="split">
    <a href="/travel-basketball-aau/" class="split-card">
      <Photo src="team-elite" alt="HYPE Elite AAU players with their coach" sizes="(min-width: 900px) 50vw, 100vw" widths={[640, 1000, 1400]} />
      <div><p class="eyebrow">Travel basketball</p><h3 class="display h2">AAU</h3><span class="link-arrow">Join the interest list<Icon name="ArrowRight" size={14} /></span></div>
    </a>
    <a href="/hype-wolves-soccer/" class="split-card">
      <Photo src="dh-turf" alt="The indoor turf at HYPE Dearborn Heights" sizes="(min-width: 900px) 50vw, 100vw" widths={[640, 1000, 1400]} />
      <div><p class="eyebrow">Travel soccer</p><h3 class="display h2">HYPE Wolves</h3><span class="link-arrow">Tryouts &amp; interest form<Icon name="ArrowRight" size={14} /></span></div>
    </a>
  </section>

  <!-- 6 · Rentals -->
  <section class="section">
    <div class="wrap rent">
      <div class="rent-copy reveal">
        <p class="eyebrow">Rentals</p>
        <h2 class="display h2">Host it at HYPE</h2>
        <p class="lede">Tournaments, practices, birthday parties, banquets and league play. Get a quote in one short form.</p>
        <dl class="stats">
          <div><dt>Courts in Dearborn Heights</dt><dd class="display">5</dd></div>
          <div><dt>Guests in the Wayne hall</dt><dd class="display">400</dd></div>
          <div><dt>Acres on Belle Isle</dt><dd class="display">38</dd></div>
        </dl>
        <div class="btn-row"><a href="/rentals/#quote" class="btn btn-primary" data-track="rental_click" data-placement="home">Get a rental quote</a><a href="/rentals/" class="btn btn-ghost">See spaces<Icon name="ArrowRight" size={16} /></a></div>
      </div>
      <div class="rent-media reveal">
        <Photo src="wayne-hall" alt="The Wayne event hall set with round tables for a banquet" sizes="(min-width: 960px) 560px, 100vw" widths={[560, 900, 1120]} />
      </div>
    </div>
  </section>

  <!-- 7 · Story -->
  <section class="story">
    <div class="wrap story-grid">
      <div class="story-in">
        <p class="eyebrow">Helping Youth Progress &amp; Excel</p>
        <p class="display quote reveal">Built in {org.founded} to keep Metro Detroit kids on the court. Still here.</p>
        <div class="btn-row"><a href="/about-us/" class="btn btn-secondary">Our story</a><a href="/donate/" class="btn btn-ghost" data-track="donate_click" data-placement="home">Support the mission<Icon name="Heart" size={16} /></a></div>
      </div>
      <div class="story-photos reveal">
        <div class="sp1"><Photo src="team-girls" alt="A HYPE girls basketball team with their trophies" sizes="(min-width: 960px) 320px, 50vw" widths={[360, 720]} position="center 30%" /></div>
        <div class="sp2"><Photo src="summer-camp" alt="Kids playing outdoor games at Summer Discovery" sizes="(min-width: 960px) 320px, 50vw" widths={[360, 720]} /></div>
      </div>
    </div>
  </section>

  <!-- 8 · Close -->
  <section class="close">
    <div class="wrap close-in">
      <h2 class="display h2">See you on the court.</h2>
      <div class="btn-row">
        <a href="/day-pass/" class="btn btn-primary btn-lg" data-track="daypass_click" data-placement="footer_cta">Get a free day pass</a>
        <a href="/membership/#plans" class="btn btn-secondary btn-lg" data-track="join_click" data-placement="footer_cta">Join now</a>
      </div>
      <p class="small muted phones">{Object.values(locations).slice(0, 2).map((l) => <span>{l.name} <a href={`tel:${l.phoneHref}`} class="mono">{l.phone}</a></span>)}</p>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: calc(100svh - var(--header-h) - var(--mobile-bar)); max-height: 960px; display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  /* Crossfade through four real spaces, 6s each. Reduced motion: first slide only. */
  .slides { position: absolute; inset: 0; z-index: -2; }
  .slide { position: absolute; inset: 0; opacity: 0; animation: fade 24s linear infinite; animation-delay: calc(var(--i) * 6s - 0.01s); }
  .slide:first-child { opacity: 1; }
  .slide :global(img) { animation: drift 24s linear infinite; animation-delay: inherit; }
  @keyframes fade { 0% { opacity: 0; } 4% { opacity: 1; } 25% { opacity: 1; } 29% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes drift { 0% { transform: scale(1.1); } 30% { transform: scale(1); } 100% { transform: scale(1); } }
  .slide:first-child { animation-name: fade-first; }
  .slide:only-child { animation: none; opacity: 1; }
  .slide:only-child :global(img) { animation: zoom 18s var(--ease-out) both; }
  @keyframes fade-first { 0% { opacity: 1; } 25% { opacity: 1; } 29% { opacity: 0; } 96% { opacity: 0; } 100% { opacity: 1; } }
  .slide-tag { position: absolute; right: max(20px, var(--gutter-r)); top: 20px; z-index: 1; font-size: var(--t-11); letter-spacing: .08em; text-transform: uppercase; color: #fff; background: rgb(0 0 0 / .55); padding: 6px 10px; border-radius: var(--r-full); backdrop-filter: blur(6px); }
  @media (prefers-reduced-motion: reduce) { .slide { animation: none !important; } .slide:not(:first-child) { display: none; } .slide :global(img) { animation: none !important; } }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--hero-scrim), linear-gradient(0deg, rgb(0 0 0 / .65), transparent 50%); }
  @keyframes zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
  .hero-in { padding-block: 96px 56px; color: #fff; }
  @media (min-width: 900px) { .hero-in { padding-block: 120px 88px; } }
  .hero-in > * + * { margin-top: 22px; }
  .hero .eyebrow { color: rgb(255 255 255 / .75); }
  .hero-h .ln { display: block; white-space: nowrap; }
  .hero-h { font-size: clamp(4.5rem, 17vw, 10.5rem); line-height: .86; letter-spacing: -0.02em; animation: rise 700ms var(--ease-out) both 80ms; }
  .hero-h .accent { color: #ff2847; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
  .hero .lede { color: rgb(255 255 255 / .86); max-width: 34ch; }
  .hero .lede b { color: #fff; font-weight: 500; }
  .hero :global(.btn-secondary) { --fgc: #fff; --bdc: rgb(255 255 255 / .4); }
  .hero :global(.btn-secondary:hover) { --bgc: rgb(255 255 255 / .1); }
  .proof { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: var(--t-14); color: rgb(255 255 255 / .8); }
  .proof li { display: inline-flex; align-items: center; gap: 6px; }
  @media (max-width: 420px) { .hide-xs { display: none !important; } }
  .proof :global(.icon) { color: #ff5468; }

  .ins-band {
    margin-top: 32px; display: grid; gap: 20px; align-items: center; padding: 28px;
    border-radius: var(--r-18); border: 1px solid var(--line); text-decoration: none; color: var(--fg);
    background: radial-gradient(90% 120% at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%), var(--surface);
    transition: border-color var(--d-std) var(--ease), transform var(--d-std) var(--ease-out);
  }
  .ins-band:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  @media (min-width: 900px) { .ins-band { grid-template-columns: minmax(0, 1fr) auto; padding: 32px 40px; } }
  .ins-copy { display: grid; gap: 10px; }
  .ins-title { font-size: clamp(var(--t-32), 4vw, var(--t-40)); line-height: .95; }
  .ins-names { font-size: var(--t-14); color: var(--fg-3); }
  .ins-cta { justify-self: start; }
  @media (max-width: 599px) { .ins-band { padding: 22px 20px; } .ins-cta { justify-self: stretch; } }
  .ages { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: -12px 0 28px; }
  .ages span { margin-right: 6px; }
  @media (max-width: 599px) {
    .ages { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-right: calc(-1 * var(--gutter-r)); padding-right: var(--gutter-r); }
    .ages::-webkit-scrollbar { display: none; }
    .ages span { display: none; }
    .ages a { flex-shrink: 0; }
    .reveal-stagger > :global(:nth-child(n+4)) { display: none; }
    .stats dd { font-size: var(--t-40); }
    .stats dt { font-size: var(--t-11); }
    .split-card { min-height: 320px; }
    .story { padding-block: 80px; }
    .close { padding-block: 72px 88px; }
    .hero-in > * + * { margin-top: 18px; }
  }
  .ages a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: var(--r-full); border: 1px solid var(--line-strong); text-decoration: none; font-size: var(--t-14); font-weight: 500; transition: all var(--d-micro) var(--ease); }
  .ages a:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }

  .split { display: grid; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1fr; } }
  .split-card { position: relative; display: grid; align-items: end; min-height: 420px; overflow: hidden; isolation: isolate; text-decoration: none; color: #fff; }
  .split-card :global(img) { position: absolute; inset: 0; z-index: -2; transition: transform 800ms var(--ease-out); }
  .split-card:hover :global(img) { transform: scale(1.05); }
  .split-card::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--scrim); }
  .split-card > div { padding: 40px max(24px, 4vw); display: grid; gap: 12px; }
  .split-card .eyebrow { color: rgb(255 255 255 / .75); }
  .split-card .link-arrow { color: #fff; }

  .rent { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .rent { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 72px; } }
  .rent-copy > * + * { margin-top: 18px; }
  .rent-copy .btn-row { margin-top: 32px; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 32px 0 0; }
  .stats div { border-top: 2px solid var(--accent); padding-top: 12px; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 4px; }
  .stats dt { font-size: var(--t-12); color: var(--fg-3); }
  .stats dd { margin: 0; font-size: var(--t-64); line-height: .9; font-variant-numeric: tabular-nums; }
  .rent-media { aspect-ratio: 4 / 3; border-radius: var(--r-18); overflow: hidden; }

  .story { padding-block: 120px; border-top: 1px solid var(--line); background:
    radial-gradient(60% 80% at 85% 20%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%), var(--bg-2); }
  .story-in > * + * { margin-top: 28px; }
  .story-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 960px) { .story-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 64px; } }
  .story-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .story-photos > div { border-radius: var(--r-12); overflow: hidden; aspect-ratio: 3 / 4; }
  .sp2 { margin-top: 48px; }
  .quote { font-size: clamp(var(--t-40), 6vw, 5.5rem); line-height: .92; max-width: 16ch; }

  .close { padding-block: 96px 120px; text-align: center; }
  .close-in { display: grid; justify-items: center; gap: 28px; }
  .close .btn-row { justify-content: center; }
  .phones { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 20px; }
  .phones a { color: var(--fg-2); text-decoration: none; }
</style>
