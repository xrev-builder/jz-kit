---
import Page from '../components/Page.astro';
import Icon from '../components/Icon.astro';
import { membership } from '../data/site';
---
<Page title="Insurance-paid memberships" seoTitle="SilverSneakers & Insurance-Paid Gym Memberships" description="HYPE Athletics accepts SilverSneakers, Silver & Fit, Active & Fit, Renew Active, Prime, PeerFit and Gympass. Your insurance may cover your gym membership."
  eyebrow="Fitness · Older adults" lede="Fitness has no age limit. Many Medicare Advantage and employer plans cover a HYPE membership, often at no cost to you."
  photo="dh-fitness" photoAlt="Cardio machines at HYPE Dearborn Heights">
  <section class="section">
    <div class="wrap grid grid-2">
      <div class="stack-16">
        <h2 class="display h3">Programs we accept</h2>
        <ul class="ins">{membership.insurance.map((i) => <li class="card"><Icon name="BadgeCheck" size={16} />{i}</li>)}</ul>
        <p class="small muted">Check eligibility with <a href="https://tools.silversneakers.com/" rel="noopener" target="_blank">SilverSneakers</a> or <a href="https://www.silverandfit.com/" rel="noopener" target="_blank">Silver &amp; Fit</a>, then bring your member ID to the front desk.</p>
      </div>
      <div class="stack-16">
        <h2 class="display h3">Why join</h2>
        <ul class="checks">
          <li><Icon name="Check" size={16} />Gentle yet effective workouts for mobility and strength</li>
          <li><Icon name="Check" size={16} />Free fitness assessment with a certified trainer</li>
          <li><Icon name="Check" size={16} />Group classes and a welcoming community</li>
          <li><Icon name="Check" size={16} />Discounted senior plans if your insurance doesn’t cover it</li>
        </ul>
        <a href="/membership/" class="btn btn-primary">See membership plans</a>
      </div>
    </div>
  </section>
</Page>
<style>
  .ins { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .ins li { display: flex; gap: 8px; align-items: center; padding: 12px 14px; font-size: var(--t-14); font-weight: 500; }
  .ins :global(.icon) { color: var(--ok); }
</style>
