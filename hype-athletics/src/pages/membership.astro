---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import PlanPicker from '../components/PlanPicker.astro';
import DayPass from '../components/DayPass.astro';
import FacilityTour from '../components/FacilityTour.astro';
import { membership, locations, hours } from '../data/site';

const from = Math.min(...membership.locations.map((l) => l.tiers.find((t) => t.name === 'Individual')!.eft));
const perks = [
  { icon: 'Dumbbell', t: 'Full gym', d: 'Cardio, machines, free weights and turf.' },
  { icon: 'Music', t: 'Group classes', d: 'Zumba, HIIT and more. Free for members.' },
  { icon: 'Baby', t: 'Free child care', d: 'Work out while the kids are looked after.' },
  { icon: 'BookOpen', t: 'Homework Club', d: 'Free after-school help, STEM and art for ages 6–12.' },
  { icon: 'Flame', t: 'Steam & sauna', d: 'Men’s and women’s, in Dearborn Heights.' },
  { icon: 'Users', t: 'Women-only gym', d: 'A private gym and classes in Dearborn Heights.' },
];
const faq = [
  ['Can I try it before I join?', 'Yes. Claim a free day pass online: verify your phone and email, pick a day, and show the pass at the front desk. One per person.'],
  ['What’s the difference between the two centers?', 'A Dearborn Heights membership includes both HYPE facilities. A Wayne membership covers the Wayne center at a lower price.'],
  ['Why is bank draft cheaper?', 'Paying by monthly bank draft (EFT) saves $3 a month compared with credit card autopay.'],
  ['Does insurance cover my membership?', `HYPE accepts ${membership.insurance.slice(0, 4).join(', ')} and more. Bring your member ID to the front desk to activate.`],
  ['Can I bring a guest?', membership.guestPass],
  ['What are your hours?', hours.map((h) => `${h.days}: ${h.time}`).join('. ') + '.'],
];
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'Product', name: 'HYPE Athletics membership',
    description: 'Gym membership with group fitness classes and free child care at HYPE Athletics in Dearborn Heights and Wayne, MI.',
    brand: { '@id': 'https://hypeathletics.org/#org' },
    offers: membership.locations.flatMap((m) => m.tiers.map((t) => ({
      '@type': 'Offer', name: `${locations[m.id].name} · ${t.name}`, price: t.eft, priceCurrency: 'USD',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: t.eft, priceCurrency: 'USD', unitCode: 'MON' },
      url: 'https://hypeathletics.org/membership/', availability: 'https://schema.org/InStock',
    }))),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Gym Membership in Dearborn Heights & Wayne · First Visit Free" description={`HYPE Athletics memberships in Dearborn Heights and Wayne, MI: full gym, group classes, free child care and Homework Club. Family and senior plans. First visit free with a day pass.`}
  ogPhoto="dh-fitness" jsonLd={ld} crumbs={[{ name: 'Membership', href: '/membership/' }]}>

  <section class="hero">
    <div class="wrap hero-in">
      <div>
        <p class="eyebrow red">Membership</p>
        <h1 class="display h1">Join HYPE</h1>
      </div>
      <p class="lede">A full gym, group classes, free child care and a community that shows up.</p>
    </div>
  </section>

  <section class="section tight" id="plans">
    <div class="wrap"><PlanPicker /></div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <div class="sec-head reveal"><div><p class="eyebrow">Included with every plan</p><h2 class="display h2">More than a gym</h2></div></div>
      <ul class="perks reveal-stagger">
        {perks.map((p) => <li><Icon name={p.icon as any} size={24} /><h3 class="h4">{p.t}</h3><p class="small muted">{p.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal"><div><p class="eyebrow">See it first</p><h2 class="display h2">Walk the floor</h2></div><a href="/facilities/" class="link-arrow">Full facility tour<Icon name="ArrowRight" size={16} /></a></div>
      <FacilityTour only={['dearborn-heights', 'wayne']} id="m-tour" />
    </div>
  </section>

  <section class="section tint">
    <div class="wrap ins">
      <div class="stack-16 reveal">
        <p class="eyebrow">59 and over</p>
        <h2 class="display h2">Your insurance may pay for it</h2>
        <p class="muted">Many Medicare Advantage and employer plans cover a HYPE membership. If yours does, it could cost you nothing.</p>
        <a href="/insurance/" class="link-arrow">How it works<Icon name="ArrowRight" size={16} /></a>
      </div>
      <ul class="logos reveal-stagger">{membership.insurance.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <section class="section" id="day-pass">
    <div class="wrap tour-grid">
      <div class="stack-16">
        <p class="eyebrow">Not ready to join?</p>
        <h2 class="display h2">Try it free for a day</h2>
        <p class="muted">Verify your phone and email, pick a day, and show your pass at the front desk.</p>
        <div class="photo-sm"><Photo src="dh-gym" alt="The fitness floor at HYPE Dearborn Heights" sizes="(min-width: 960px) 460px, 100vw" widths={[480, 920]} /></div>
      </div>
      <div class="card form-card"><DayPass id="m-daypass" /></div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap faq-wrap">
      <h2 class="display h2">Questions</h2>
      <div class="qs">
        {faq.map(([q, a]) => <details><summary><span class="h4">{q}</span><span class="plus" aria-hidden="true"></span></summary><p class="muted">{a}</p></details>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .hero { padding-block: 64px 16px; }
  @media (min-width: 900px) { .hero { padding-block: 104px 24px; } }
  .hero-in { display: grid; gap: 24px; align-items: end; }
  @media (min-width: 1000px) { .hero-in { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 56px; } }
  .hero .h1 { margin-top: 18px; }
  .lede b { color: var(--fg); font-weight: 500; }
  .perks { list-style: none; display: grid; gap: 1px; grid-template-columns: repeat(2, minmax(0, 1fr)); background: var(--line); border: 1px solid var(--line); border-radius: var(--r-12); overflow: hidden; }
  @media (min-width: 900px) { .perks { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .perks li { background: var(--surface); padding: 28px; display: grid; gap: 8px; align-content: start; }
  @media (max-width: 599px) {
    .perks { grid-template-columns: 1fr; }
    .perks li { grid-template-columns: 28px 1fr; column-gap: 16px; row-gap: 4px; padding: 20px; }
    .perks li :global(.icon) { grid-row: span 2; margin: 2px 0 0; }
  }
  .perks :global(.icon) { color: var(--accent-text); margin-bottom: 8px; }
  .ins { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .ins { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 72px; } }
  .logos { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .logos li { padding: 18px; border: 1px solid var(--line); border-radius: var(--r-10); background: var(--surface); font-weight: 600; text-align: center; }
  .tour-grid { display: grid; gap: 40px; }
  @media (min-width: 960px) { .tour-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 72px; align-items: start; } }
  .photo-sm { aspect-ratio: 16 / 10; border-radius: var(--r-12); overflow: hidden; margin-top: 28px; }
  .form-card { padding: 24px 20px; }
  @media (min-width: 640px) { .form-card { padding: 36px; } }
  .photo-sm { display: none; }
  @media (min-width: 960px) { .photo-sm { display: block; } }
  .faq-wrap { display: grid; gap: 32px; }
  @media (min-width: 960px) { .faq-wrap { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 72px; } }
  .qs { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; background: var(--fg-3); transition: transform var(--d-std) var(--ease-out); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0); }
  details p { padding-bottom: 22px; max-width: 62ch; }
</style>
